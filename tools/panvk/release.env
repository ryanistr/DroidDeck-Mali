PANVK_REPO=ryanistr/DroidDeck-Mali
PANVK_TAG=panvk-linux-g57-1.2.0-p3
PANVK_SHA256=ea34e92717f3fbfc584616878489177fb212f91fb8d98fd89c9ebe0592472afc
# Built from the Mali-G57 fork (tools/panvk-g57/build-panvk-g57.sh + its patches) rather than from
# our own mesa-patches: only that tree has a Valhall JM backend at all, and from v1.2.0 it gates the
# external memory/semaphore fd group on PANVK_FD_INTEROP, which gamescope requires. p13 shipped no
# v9 backend, so a Valhall device enumerated no GPU and gamescope reported no physical device.
PANVK_SOURCE=mesa-panvk-mali-g57 v1.2.0
PANVK_WORKFLOW=.github/workflows/build-panvk-g57.yml