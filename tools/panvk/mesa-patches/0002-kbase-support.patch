 }
 
+extern struct pan_kmod_dev *pan_kbase_kmod_dev_create(const struct pan_kmod_allocator *allocator);
+
+static VkResult
+panvk_physical_device_enumerate(struct vk_instance *vk_instance)
+{
+   struct panvk_instance *instance =
+      container_of(vk_instance, struct panvk_instance, vk);
+
+   struct pan_kmod_dev *kdev = pan_kbase_kmod_dev_create(&instance->kmod.allocator);
+   if (kdev) {
+      struct panvk_physical_device *device =
+         vk_zalloc(&instance->vk.alloc, sizeof(*device), 8,
+                   VK_SYSTEM_ALLOCATION_SCOPE_INSTANCE);
+      if (!device) {
+         pan_kmod_dev_destroy(kdev);
+         return VK_ERROR_OUT_OF_HOST_MEMORY;
+      }
+      device->kmod.dev = kdev;
+      VkResult result = panvk_physical_device_init(device, instance, NULL);
+      if (result != VK_SUCCESS) {
+         vk_free(&instance->vk.alloc, device);
+         return result;
+      }
+      list_addtail(&device->vk.link, &instance->vk.physical_devices.list);
+      return VK_SUCCESS;
+   }
+   return VK_ERROR_INCOMPATIBLE_DRIVER;
+}
+
 static void
 panvk_destroy_physical_device(struct vk_physical_device *device)
 {
@@ -185,6 +214,7 @@ panvk_CreateInstance(const VkInstanceCreateInfo *pCreateInfo,
       .priv = &instance->vk.alloc,
    };
 
+   instance->vk.physical_devices.enumerate = panvk_physical_device_enumerate;
    instance->vk.physical_devices.try_create_for_drm =
       panvk_physical_device_try_create;
    instance->vk.physical_devices.destroy = panvk_destroy_physical_device;
