diff --git a/src/panfrost/lib/kmod/pan_kbase.c b/src/panfrost/lib/kmod/pan_kbase.c
new file mode 100644
index 0000000..bbcea0a
--- /dev/null
+++ b/src/panfrost/lib/kmod/pan_kbase.c
@@ -0,0 +1,227 @@
+#include <dlfcn.h>
+#include <fcntl.h>
+#include <unistd.h>
+#include <xf86drm.h>
+
+#include "pan_kmod.h"
+#include "pan_kmod_backend.h"
+#include "util/os_mman.h"
+
+struct pan_kbase_dev {
+   struct pan_kmod_dev base;
+   void *rust_dev;
+   void *rust_lib;
+   
+   void *(*open_fn)(void);
+   void (*close_fn)(void *);
+   void *(*alloc_bo_fn)(void *, uint64_t, uint32_t);
+   void (*free_bo_fn)(void *, void *);
+   uint64_t (*bo_gpu_va_fn)(void *);
+   uint64_t (*bo_size_fn)(void *);
+   uint64_t (*get_gpu_id_fn)(void *);
+};
+
+struct pan_kbase_bo {
+   struct pan_kmod_bo base;
+   void *rust_bo;
+};
+
+static void
+pan_kbase_dev_destroy(struct pan_kmod_dev *dev)
+{
+   struct pan_kbase_dev *kdev = (struct pan_kbase_dev *)dev;
+   if (kdev->rust_dev && kdev->close_fn) {
+      kdev->close_fn(kdev->rust_dev);
+   }
+   if (kdev->rust_lib) {
+      dlclose(kdev->rust_lib);
+   }
+   util_sparse_array_finish(&dev->handle_to_bo.array);
+   simple_mtx_destroy(&dev->handle_to_bo.lock);
+   dev->allocator->free(dev->allocator, kdev);
+}
+
+static void
+pan_kbase_dev_query_props(const struct pan_kmod_dev *dev,
+                          struct pan_kmod_dev_props *props)
+{
+   struct pan_kbase_dev *kdev = (struct pan_kbase_dev *)dev;
+   memset(props, 0, sizeof(*props));
+   if (kdev->get_gpu_id_fn) {
+      props->gpu_prod_id = kdev->get_gpu_id_fn(kdev->rust_dev);
+   }
+}
+
+static uint32_t next_handle = 1;
+
+static struct pan_kmod_bo *
+pan_kbase_bo_alloc(struct pan_kmod_dev *dev, struct pan_kmod_vm *exclusive_vm,
+                   size_t size, uint32_t flags)
+{
+   struct pan_kbase_dev *kdev = (struct pan_kbase_dev *)dev;
+   
+   void *rust_bo = kdev->alloc_bo_fn(kdev->rust_dev, size, flags);
+   if (!rust_bo) return NULL;
+   
+   struct pan_kbase_bo *kbo = dev->allocator->zalloc(dev->allocator, sizeof(*kbo), false);
+   if (!kbo) {
+      kdev->free_bo_fn(kdev->rust_dev, rust_bo);
+      return NULL;
+   }
+   
+   kbo->rust_bo = rust_bo;
+   kbo->base.dev = dev;
+   kbo->base.size = kdev->bo_size_fn(rust_bo);
+   kbo->base.handle = __sync_fetch_and_add(&next_handle, 1);
+   kbo->base.flags = flags;
+   kbo->base.exclusive_vm = exclusive_vm;
+   return &kbo->base;
+}
+
+static void
+pan_kbase_bo_free(struct pan_kmod_bo *bo)
+{
+   struct pan_kbase_bo *kbo = (struct pan_kbase_bo *)bo;
+   struct pan_kbase_dev *kdev = (struct pan_kbase_dev *)bo->dev;
+   
+   kdev->free_bo_fn(kdev->rust_dev, kbo->rust_bo);
+   bo->dev->allocator->free(bo->dev->allocator, kbo);
+}
+
+static off_t
+pan_kbase_bo_get_mmap_offset(struct pan_kmod_bo *bo)
+{
+   struct pan_kbase_bo *kbo = (struct pan_kbase_bo *)bo;
+   struct pan_kbase_dev *kdev = (struct pan_kbase_dev *)bo->dev;
+   if (kdev->bo_gpu_va_fn)
+      return (off_t)kdev->bo_gpu_va_fn(kbo->rust_bo);
+   return 0;
+}
+
+static bool
+pan_kbase_bo_wait(struct pan_kmod_bo *bo, int64_t timeout_ns,
+                  bool for_read_only_access)
+{
+   return true; // No-op
+}
+
+struct pan_kbase_vm {
+   struct pan_kmod_vm base;
+};
+
+static struct pan_kmod_vm *
+pan_kbase_vm_create(struct pan_kmod_dev *dev, uint32_t flags, uint64_t va_start,
+                    uint64_t va_range)
+{
+   struct pan_kbase_vm *vm = dev->allocator->zalloc(dev->allocator, sizeof(*vm), false);
+   if (!vm) return NULL;
+   /* kbase rejects mmap address hints, so the VA can only come from the BO's cookie mapping. */
+   pan_kmod_vm_init(&vm->base, dev, 0, flags | PAN_KMOD_VM_FLAG_AUTO_VA);
+   return &vm->base;
+}
+
+static void
+pan_kbase_vm_destroy(struct pan_kmod_vm *vm)
+{
+   vm->dev->allocator->free(vm->dev->allocator, vm);
+}
+
+static int
+pan_kbase_vm_bind(struct pan_kmod_vm *vm, enum pan_kmod_vm_op_mode mode,
+                  struct pan_kmod_vm_op *ops, uint32_t op_count)
+{
+   for (uint32_t i = 0; i < op_count; i++) {
+      if (ops[i].type == PAN_KMOD_VM_OP_TYPE_MAP) {
+         struct pan_kbase_bo *kbo = (struct pan_kbase_bo *)ops[i].map.bo;
+         struct pan_kbase_dev *kdev = (struct pan_kbase_dev *)kbo->base.dev;
+         if (kdev->bo_gpu_va_fn)
+            ops[i].va.start = kdev->bo_gpu_va_fn(kbo->rust_bo);
+      }
+   }
+   return 0;
+}
+
+static struct pan_kmod_va_range
+pan_kbase_dev_query_user_va_range(const struct pan_kmod_dev *dev)
+{
+   return (struct pan_kmod_va_range){
+      .start = 0x2000000ull,
+      .size = 0xffe000000ull,
+   };
+}
+
+const struct pan_kmod_ops pan_kbase_ops = {
+   .dev_destroy = pan_kbase_dev_destroy,
+   .dev_query_props = pan_kbase_dev_query_props,
+   .dev_query_user_va_range = pan_kbase_dev_query_user_va_range,
+   .bo_alloc = pan_kbase_bo_alloc,
+   .bo_free = pan_kbase_bo_free,
+   .bo_get_mmap_offset = pan_kbase_bo_get_mmap_offset,
+   .bo_wait = pan_kbase_bo_wait,
+   .vm_create = pan_kbase_vm_create,
+   .vm_destroy = pan_kbase_vm_destroy,
+   .vm_bind = pan_kbase_vm_bind,
+};
+
+struct pan_kmod_dev *
+pan_kbase_kmod_dev_create(const struct pan_kmod_allocator *allocator)
+{
+   void *lib = dlopen("libpanvk_kbase_jm.so", RTLD_NOW | RTLD_LOCAL);
+   if (!lib) return NULL;
+   
+   void *(*open_fn)(void) = dlsym(lib, "panvk_kbase_open");
+   if (!open_fn) { dlclose(lib); return NULL; }
+   
+   void *rust_dev = open_fn();
+   if (!rust_dev) { dlclose(lib); return NULL; }
+   
+   struct pan_kbase_dev *kdev = allocator->zalloc(allocator, sizeof(*kdev), true);
+   if (!kdev) { dlclose(lib); return NULL; }
+   
+   kdev->rust_lib = lib;
+   kdev->rust_dev = rust_dev;
+   kdev->open_fn = open_fn;
+   kdev->close_fn = dlsym(lib, "panvk_kbase_close");
+   kdev->alloc_bo_fn = dlsym(lib, "panvk_kbase_alloc_bo");
+   kdev->free_bo_fn = dlsym(lib, "panvk_kbase_free_bo");
+   kdev->bo_gpu_va_fn = dlsym(lib, "panvk_kbase_bo_gpu_va");
+   kdev->bo_size_fn = dlsym(lib, "panvk_kbase_bo_size");
+   kdev->get_gpu_id_fn = dlsym(lib, "panvk_kbase_get_gpu_id");
+   
+   int (*get_fd_fn)(void *) = dlsym(lib, "panvk_kbase_get_fd");
+   kdev->base.fd = get_fd_fn ? get_fd_fn(rust_dev) : -1;
+   kdev->base.ops = &pan_kbase_ops;
+   kdev->base.allocator = allocator;
+   
+   simple_mtx_init(&kdev->base.handle_to_bo.lock, mtx_plain);
+   util_sparse_array_init(&kdev->base.handle_to_bo.array, sizeof(struct pan_kmod_bo *), 64);
+   
+   return &kdev->base;
+}
+
+int pan_kbase_jm_submit(struct pan_kmod_dev *dev, const void *submit_void)
+{
+   const struct drm_panfrost_submit *submit = submit_void;
+   struct pan_kbase_dev *kdev = (struct pan_kbase_dev *)dev;
+   int (*submit_fn)(void *, const struct drm_panfrost_submit *) = dlsym(kdev->rust_lib, "panvk_kbase_submit");
+   if (!submit_fn) return -1;
+   return submit_fn(kdev->rust_dev, submit);
+}
+
+uint64_t pan_kbase_get_primary_rdev(struct pan_kmod_dev *dev)
+{
+   struct pan_kbase_dev *kdev = (struct pan_kbase_dev *)dev;
+   if (!kdev || !kdev->rust_lib) return 0;
+   uint64_t (*fn)(void *) = dlsym(kdev->rust_lib, "panvk_kbase_get_drm_primary_rdev");
+   if (fn) return fn(kdev->rust_dev);
+   return 0;
+}
+
+uint64_t pan_kbase_get_render_rdev(struct pan_kmod_dev *dev)
+{
+   struct pan_kbase_dev *kdev = (struct pan_kbase_dev *)dev;
+   if (!kdev || !kdev->rust_lib) return 0;
+   uint64_t (*fn)(void *) = dlsym(kdev->rust_lib, "panvk_kbase_get_drm_render_rdev");
+   if (fn) return fn(kdev->rust_dev);
+   return 0;
+}
