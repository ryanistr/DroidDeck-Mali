PanVK needs no OpenCL C, but merely enabling panfrost Vulkan puts it in
with_driver_using_cl, which turns on with_clc and with it libclc, LLVM and the
SPIR-V-LLVM translator (required, not optional). A Vulkan-only driver should not
depend on any of that, and it would otherwise be linked into the shipped .so and
have to be present in the runtime as well.

--- a/meson.build
+++ b/meson.build
@@ -929,7 +929,9 @@
 with_driver_using_cl = [
   with_gallium_iris, with_gallium_crocus, with_intel_vk, with_intel_hasvk,
   with_gallium_asahi, with_asahi_vk, with_tools.contains('asahi'),
-  with_gallium_panfrost, with_panfrost_vk,
+  # DroidDeck: dropped with_gallium_panfrost/with_panfrost_vk. Merely enabling PanVK here
+  # makes the build require libclc, LLVM and the SPIR-V-LLVM translator, none of which a
+  # Vulkan driver runs, and which would otherwise be linked into the shipped .so.
   with_gallium_rusticl,
   with_nouveau_vk, with_imagination_vk,
   with_kosmickrisp_vk,
