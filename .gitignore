*.iml
.gradle/
local.properties
.idea/
.DS_Store
build/
captures/
.externalNativeBuild/
.cxx/
.kotlin/
# Built in CI from tools/linuxfs and app/src/main/cpp/fakeinput.cpp, never committed, so the two
# copies cannot drift.
app/src/main/assets/linuxfs/
app/src/main/jniLibs/arm64-v8a/libproot.so
app/src/main/jniLibs/arm64-v8a/.proot-inputs
app/src/main/jniLibs/arm64-v8a/.proot-outputs
app/src/main/jniLibs/arm64-v8a/libproot-loader.so
app/src/main/jniLibs/arm64-v8a/libdirectaudiorelay.so
# The store download engines (app/src/main/rust/stores) are cross-compiled by Gradle into
# app/build/rustJniLibs; cargo's own build tree stays next to the crate. Neither is source.
app/src/main/rust/stores/target/
# The kbase backend crate builds the same way; its cargo tree is not source either.
app/src/main/rust/panvk-kbase-jm/target/
# A Mesa checkout kept at the root to build the PanVK drivers locally; the driver builds clone
# their own, so this is never source (and as a nested repo it would become a bogus gitlink).
/mesa/
app/src/main/assets/droiddeck-esync/

# Kotlin compiler session files (build-tool state, never source).
.kotlin/

# Signing keys never enter the repo (DroidDeck's lives in GitHub environment secrets; see
# tools/release/make-release-key.sh). keystore/testkey.p12 is the public AOSP testkey.
*.jks
*.keystore
*.p12
*.pfx
*.pk8
*.pem
!keystore/testkey.p12
droiddeck-release-key/
password.txt
__pycache__/

# Local signing with the release key (tools/build_local.sh); holds a password.
.signing.env
app/src/main/assets/directaudio/

# Scratch notes (handoffs, plans, reports) are working files, never part of the tree. Root
# markdown is ignored by default; a real doc at the root has to be allowed explicitly.
/*.md
!/AGENTS.md
!/CLAUDE.md
!/README.md

# Working trees and experiment scratch: source clones and build dirs that must never be committed.
# .scratch/ alone reached 3.4G here (a Mesa clone plus a build dir), so a `git add -A` would
# otherwise try to stage a whole checkout.
/.scratch/
/.ppv/
